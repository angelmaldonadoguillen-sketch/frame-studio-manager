rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// FRAME Studio Manager — Reglas de seguridad de Firestore
//
// Este proyecto Firebase (tooned-os) aloja DOS aplicaciones que comparten
// las mismas cuentas de usuario:
//   · FRAME     → frame_*        (repo frame-studio-manager)
//   · TOONED-OS → data, thumbs   (repo TOONED-OS)
//
// Las reglas de Firestore se SUMAN: si cualquier match concede acceso, el
// acceso se concede — no gana la más específica. Por eso el
// `match /{document=**} { allow read, write: if true }` que había antes
// abría TODO, incluidas las colecciones de FRAME, por más estrictas que
// fueran sus reglas propias. Acá no hay comodín: cada colección se
// habilita explícitamente y lo demás queda denegado por defecto.
//
// Nota: mientras no exista el modelo multi-estudio (Fase 1), la lista de
// personas autorizadas es frame_users, y de ahí sale también el permiso
// para TOONED-OS.
// ─────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/frame_users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/frame_users/$(request.auth.uid));
    }

    // Miembro aprobado del estudio. Es el permiso real de FRAME:
    // "tener sesión" NO alcanza, porque el registro es abierto y además
    // el login anónimo está habilitado — cualquiera obtiene una sesión.
    function activeMember() {
      return signedIn() && profileExists() && myProfile().status == 'active';
    }

    // ── FRAME: datos del estudio ─────────────────────────────────
    // Solo miembros aprobados.
    match /frame_projects/{doc} { allow read, write: if activeMember(); }
    match /frame_clients/{doc}  { allow read, write: if activeMember(); }
    match /frame_config/{doc}   { allow read, write: if activeMember(); }
    match /frame_trash/{doc}    { allow read, write: if activeMember(); }

    // ── FRAME: perfiles de usuario ───────────────────────────────
    // Lectura para cualquier sesión: la app necesita leer esta colección
    // ANTES de saber si estás aprobado (así descubre tu propio status y
    // decide si mostrarte el tablero o la pantalla de "pendiente").
    match /frame_users/{uid} {
      allow read: if signedIn();

      // Alta de tu propio perfil durante el registro. Obligatoriamente
      // 'pending': si se permitiera cualquier status, cualquiera podría
      // registrarse escribiendo status:'active' y auto-aprobarse, lo que
      // dejaría sin efecto todo el control de acceso.
      // El primer administrador de un estudio nuevo se activa a mano
      // desde la consola de Firebase (ver SETUP.md).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending';

      // Editar tu propio perfil (nombre, rol, avatar…) sin poder
      // cambiarte el status a vos mismo.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == resource.data.status;

      // Aprobar, rechazar o dar de baja a otros: solo miembros aprobados.
      allow update, delete: if activeMember();
    }

    // ── FRAME: notificaciones ────────────────────────────────────
    // Ojo: `match /frame_notifications/{uid}` NO cubre la subcolección
    // /items — hay que declararla anidada explícitamente o cae al comodín.
    match /frame_notifications/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /items/{item} {
        // Leés y marcás como leídas solo las tuyas.
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        // Cualquier sesión puede crear una notificación en la bandeja de
        // otro: es lo que hace el registro al pedir aprobación, y en ese
        // momento el solicitante todavía no está aprobado.
        allow create: if signedIn();
      }
    }

    // ── TOONED-OS: sistema de ventas ─────────────────────────────
    // Antes el acceso lo guardaba un PIN de 4 dígitos leído desde
    // data/auth y comparado en el navegador — es decir, el "secreto" se
    // servía con la misma petición pública que los datos que protegía, y
    // esos datos se podían leer igual sin pasar por el PIN. Ahora
    // TOONED-OS usa Firebase Auth con las mismas cuentas que FRAME
    // (repo TOONED-OS, index.html) y el acceso lo decide esta regla.
    //
    // El doc data/auth quedó obsoleto y se puede borrar.
    match /data/{doc}   { allow read, write: if activeMember(); }
    match /thumbs/{doc} { allow read, write: if activeMember(); }

    // Sin comodín: en Firestore, lo que ninguna regla concede queda
    // denegado. Cualquier colección nueva nace cerrada y hay que
    // habilitarla acá a propósito.
  }
}
