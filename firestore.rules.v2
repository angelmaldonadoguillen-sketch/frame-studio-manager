rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// FRAME Studio Manager — Reglas v2: tableros (workspaces)
//
// NO PUBLICAR TODAVÍA. Estas reglas asumen que el código ya escribe
// workspaceId en los documentos y que existe frame_workspaces. Publicarlas
// antes de desplegar la Fase 1 deja la app sin acceso a nada.
// Las que están activas hoy son firestore.rules.
//
// ── El modelo ──
// Dos niveles de permiso, que hoy están mezclados en uno solo:
//
//   1. APROBACIÓN DE PLATAFORMA — frame_users/{uid}.status == 'active'
//      Decide quién puede usar FRAME. La otorga un platformAdmin.
//
//   2. PERTENENCIA A UN TABLERO — uid dentro de workspace.memberIds
//      Decide qué ve cada quien. Un usuario aprobado sin tablero no ve
//      absolutamente nada.
//
// ── Por qué memberIds es un array y no una subcolección ──
// Las reglas de Firestore no pueden contar documentos de una subcolección,
// así que el límite de 3 personas sería inaplicable desde el servidor y
// quedaría sólo en la interfaz — es decir, se saltaría desde la consola del
// navegador. Con un array se valida con memberIds.size() <= 3.
// ─────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/frame_users/$(myUid())).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/frame_users/$(myUid()));
    }

    // Nivel 1: aprobado para usar la plataforma.
    function approved() {
      return signedIn() && userExists() && userDoc().status == 'active';
    }

    function isPlatformAdmin() {
      return approved() && userDoc().platformAdmin == true;
    }

    function ws(wsId) {
      return get(/databases/$(database)/documents/frame_workspaces/$(wsId)).data;
    }

    function wsExists(wsId) {
      return exists(/databases/$(database)/documents/frame_workspaces/$(wsId));
    }

    // Nivel 2: pertenece a ese tablero.
    function isMember(wsId) {
      return approved() && wsExists(wsId) && myUid() in ws(wsId).memberIds;
    }

    function isOwner(wsId) {
      return approved() && wsExists(wsId) && ws(wsId).ownerId == myUid();
    }

    // Los datos de un proyecto/cliente viven o van a vivir en un tablero.
    // En create hay que mirar el documento entrante; en el resto, el guardado.
    function memberOfIncoming() {
      return isMember(request.resource.data.workspaceId);
    }
    function memberOfExisting() {
      return isMember(resource.data.workspaceId);
    }

    // ── Tableros ─────────────────────────────────────────────────
    match /frame_workspaces/{wsId} {

      // Se mira resource.data directamente en vez de isMember(), que haría un
      // get() del mismo documento que se está leyendo. En una consulta de
      // lista —que es como la app pide los tableros del usuario— Firestore ya
      // tiene el documento a mano; el get() sobra y hace fallar la consulta.
      allow read: if approved() && myUid() in resource.data.memberIds;

      // Crear: sólo para uno mismo, arrancando como único miembro y dueño.
      // Sin esto, alguien podría crear un tablero poniendo a otro de dueño.
      allow create: if approved()
                    && request.resource.data.ownerId == myUid()
                    && request.resource.data.memberIds == [myUid()]
                    && request.resource.data.kind in ['personal', 'team'];

      // Actualizar: cualquier miembro puede editar el tablero (nombre, etc.),
      // pero el dueño no se puede cambiar y el límite de 3 es infranqueable.
      // Los tableros personales no admiten un segundo miembro.
      // Dos caminos distintos, y por eso el OR:
      //
      //   1. Un miembro editando su tablero.
      //   2. Un invitado entrando. Este NO es miembro todavía, así que no
      //      puede pasar por el primero — pero sólo se le permite agregarse
      //      a sí mismo, y únicamente si existe una invitación para su email.
      //
      // Igual que en read, se usa resource.data en vez de isMember()/isOwner():
      // traerían con get() el mismo documento que la operación ya tiene.
      allow update: if approved() && (

        ( myUid() in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.kind    == resource.data.kind
          && request.resource.data.memberIds.size() <=
             (resource.data.kind == 'personal' ? 1 : 3)
          // Sólo el dueño toca la lista de miembros; el resto puede editar
          // todo lo demás pero no invitar ni expulsar.
          && (request.resource.data.memberIds == resource.data.memberIds
              || resource.data.ownerId == myUid()
              // salvo irse por cuenta propia
              || (request.resource.data.memberIds ==
                  resource.data.memberIds.removeAll([myUid()]))) )

        ||

        ( !(myUid() in resource.data.memberIds)
          && resource.data.kind == 'team'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.kind    == resource.data.kind
          // Exactamente él mismo, ni uno más.
          && request.resource.data.memberIds == resource.data.memberIds.concat([myUid()])
          && request.resource.data.memberIds.size() <= 3
          && exists(/databases/$(database)/documents/frame_invites/$(wsId + '__' + request.auth.token.email)) )
      );

      // El dueño puede borrar cualquier tablero suyo, personal incluido.
      // Antes sólo se permitía borrar los de equipo, con lo cual los tableros
      // personales duplicados —que se generaron cuando el listener fallaba y
      // el alta automática los leía como "no tiene ninguno"— quedaban para
      // siempre y sin forma de limpiarlos desde la app.
      // Que no se quede sin ninguno se controla en la interfaz: es una regla
      // de usabilidad, no de seguridad.
      allow delete: if approved() && resource.data.ownerId == myUid();

      // ── Config por tablero ──
      // kanban_columns, project_types, display_settings. Antes eran
      // singletons globales en frame_config: con varios tableros, las
      // columnas de uno se le aplicaban a todos.
      match /config/{doc} {
        allow read, write: if isMember(wsId)
                           && doc in ['kanban_columns', 'project_types', 'display_settings', 'daily_routine'];
      }

    }

    // ── Invitaciones ─────────────────────────────────────────────
    // Va en la raíz y no dentro del tablero a propósito: el invitado todavía
    // no es miembro, así que no puede leer nada de adentro. Acá puede
    // consultar las suyas filtrando por su email.
    //
    // El id es workspaceId + '__' + email, para que la regla de alta del
    // tablero pueda comprobar que existe sin tener que buscarla.
    //
    // La invitación lleva copiado el nombre del tablero: sin eso el invitado
    // vería una invitación sin poder saber a qué lo invitan.
    match /frame_invites/{inviteId} {

      allow read: if signedIn() && (
        resource.data.email == request.auth.token.email
        || myUid() in ws(resource.data.workspaceId).memberIds
      );

      allow create: if approved()
                    && ws(request.resource.data.workspaceId).ownerId == myUid()
                    && ws(request.resource.data.workspaceId).kind == 'team'
                    && inviteId == request.resource.data.workspaceId + '__' + request.resource.data.email;

      // La borra quien invitó (se arrepintió) o el invitado (al aceptar o
      // rechazar). Que el invitado pueda borrarla es lo que evita que una
      // invitación usada quede sirviendo para volver a entrar.
      allow delete: if signedIn() && (
        resource.data.email == request.auth.token.email
        || ws(resource.data.workspaceId).ownerId == myUid()
      );
    }

    // ── Datos del tablero ────────────────────────────────────────
    match /frame_projects/{doc} {
      allow read, delete: if memberOfExisting();
      allow create:       if memberOfIncoming();
      // En update se exigen ambos: impide mover un documento a un tablero
      // ajeno cambiándole el workspaceId.
      allow update:       if memberOfExisting() && memberOfIncoming();

      match /comments/{commentId} {
        function parentProject() {
          return get(/databases/$(database)/documents/frame_projects/$(doc)).data;
        }

        allow read: if isMember(parentProject().workspaceId);
        allow create: if isMember(parentProject().workspaceId)
                      && request.resource.data.id == commentId
                      && request.resource.data.userId == myUid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 5000
                      && request.resource.data.at is string;
        allow update: if false;
        allow delete: if isMember(parentProject().workspaceId)
                      && resource.data.userId == myUid();
      }

      match /activity/{activityId} {
        function parentProject() {
          return get(/databases/$(database)/documents/frame_projects/$(doc)).data;
        }

        allow read: if isMember(parentProject().workspaceId);
        // El historial es inmutable: cada persona sólo puede agregar un evento
        // propio, nunca modificar o borrar el rastro de otra persona.
        allow create: if isMember(parentProject().workspaceId)
                      && request.resource.data.id == activityId
                      && request.resource.data.actorId == myUid()
                      && request.resource.data.actorName is string
                      && request.resource.data.summary is string
                      && request.resource.data.summary.size() > 0
                      && request.resource.data.summary.size() <= 300
                      && request.resource.data.at is string;
        allow update, delete: if false;
      }
    }

    match /frame_clients/{doc} {
      allow read, delete: if memberOfExisting();
      allow create:       if memberOfIncoming();
      allow update:       if memberOfExisting() && memberOfIncoming();
    }

    match /frame_trash/{doc} {
      allow read, delete: if memberOfExisting();
      allow create:       if memberOfIncoming();
      allow update:       if memberOfExisting() && memberOfIncoming();
    }

    // ── Perfiles ─────────────────────────────────────────────────
    match /frame_users/{uid} {

      // Antes era `allow read: if signedIn()`, que con varios equipos dejaba
      // que cualquier registrado leyera el email, nombre y rol de todos los
      // usuarios de todos los demás tableros. Ahora: sólo el propio perfil,
      // y el admin para poder aprobar.
      allow read: if signedIn() && (myUid() == uid || isPlatformAdmin());

      // Alta obligatoriamente pendiente y sin privilegios: si se permitiera
      // cualquier valor, bastaría con registrarse mandando status:'active'
      // y platformAdmin:true para tomar control de la plataforma.
      allow create: if signedIn() && myUid() == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.get('platformAdmin', false) == false;

      // Editar el propio perfil sin poder auto-promoverse.
      allow update: if signedIn() && myUid() == uid
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.get('platformAdmin', false)
                       == resource.data.get('platformAdmin', false);

      // Aprobar, rechazar y dar de baja: sólo el admin de plataforma.
      // Antes lo podía hacer cualquier miembro activo, con lo cual el primer
      // aprobado podía aprobar a cualquiera.
      allow update, delete: if isPlatformAdmin();
    }

    // ── Configuración global retirada ───────────────────────────
    // La app v2 no lee ni escribe acá: cada tablero, personal o de equipo,
    // mantiene su propia configuración bajo frame_workspaces/{wsId}/config.
    // El documento remoto heredado se elimina sólo como operación manual y
    // confirmada después de publicar código + reglas; hasta entonces queda
    // inaccesible para todos los clientes.
    match /frame_config/{doc} {
      allow read, create, update, delete: if false;
    }

    // ── Notificaciones ───────────────────────────────────────────
    match /frame_notifications/{uid} {
      allow read: if signedIn() && myUid() == uid;
      allow create, update, delete: if false;

      match /items/{item} {
        allow read, delete: if signedIn() && myUid() == uid;
        allow update: if signedIn() && myUid() == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'resolved', 'resolvedAction']);
        // Los únicos avisos creados por el cliente son menciones y cambios de
        // estado de un proyecto compartido. Emisor y receptor deben ser
        // miembros del mismo tablero, y el proyecto debe pertenecer a él.
        // El límite de tres miembros del tablero acota además los receptores.
        allow create: if approved()
                      && uid != myUid()
                      && request.resource.data.senderId == myUid()
                      && request.resource.data.id == item
                      && request.resource.data.read == false
                      && request.resource.data.type in ['mention', 'status']
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 500
                      && request.resource.data.workspaceId is string
                      && request.resource.data.projectId is string
                      && isMember(request.resource.data.workspaceId)
                      && uid in ws(request.resource.data.workspaceId).memberIds
                      && exists(/databases/$(database)/documents/frame_projects/$(request.resource.data.projectId))
                      && get(/databases/$(database)/documents/frame_projects/$(request.resource.data.projectId)).data.workspaceId
                         == request.resource.data.workspaceId;
      }
    }

    // Sin comodín: lo que ninguna regla concede queda denegado.
    // Cualquier colección nueva nace cerrada y hay que habilitarla acá a
    // propósito.
    //
    // TOONED-OS ya no aparece: vive en su propio proyecto Firebase
    // (tooned-os) con sus propias reglas. Esa separación es la que hace que
    // una regla mal escrita acá no pueda tocar el sistema de ventas.
  }
}
